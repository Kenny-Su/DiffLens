{
  "name": "difflens",
  "description": "Text editor with AI revisions and change review",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['dist', 'dist-server']) rmSync(path, { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.app.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test server/*.test.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.server.json --noEmit",
    "eval:fidelity": "tsx scripts/evaluate-fidelity.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kenny-Su/DiffLens.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Kenny-Su/DiffLens/issues"
  },
  "homepage": "https://github.com/Kenny-Su/DiffLens#readme",
  "private": true,
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-find-and-replace": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "lodash.throttle": "^4.1.1",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hotkeys-hook": "^5.3.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "concurrently": "^10.0.5",
    "sass-embedded": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
