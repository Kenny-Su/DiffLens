{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist-server",
    "sourceMap": true
  },
  "include": [
    "server",
    "shared"
  ],
  "exclude": [
    "server/**/*.test.ts"
  ]
}
